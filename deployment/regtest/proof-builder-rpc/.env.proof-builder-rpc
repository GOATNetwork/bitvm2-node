# Proof Network configuration.
# See more: https://docs.zkm.io/dev/prover.html#network-prover
ZKM_PROVER="network"
#ZKM_PROVER="local"
ENDPOINT=
ZKM_PRIVATE_KEY=

TOOL="../../circuits"
#TOOL="."
CA_CERT_PATH=${TOOL}/tool/ca.pem
SSL_CERT_PATH=${TOOL}/tool/ssl.pem
SSL_KEY_PATH=${TOOL}/tool/ssl.key

ZKM_PROOF_POLL_INTERVAL=2000
#MAX_PROVER_NUM=8
#SINGLE_NODE=true

# The database connection string.
# The DB name should be same with DB in host.

# The log directory.
ESPLORA_URL=http://localhost:13002
BITCOIN_NETWORK=regtest
DATABASE_URL=sqlite:/tmp/.bitvm-node-sd.sqlite

# GOAT contracts used for live Operator/Watchtower authorization.
GOAT_NETWORK=test
GOAT_CHAIN_URL=https://rpc.testnet3.goat.network
# Proof Builder accepts a comma-separated list; each Node still configures one Gateway address.
GOAT_GATEWAY_CONTRACT_ADDRESS=0x26Aa99d72f5f85D60A1B44773B3897793981B7F7
