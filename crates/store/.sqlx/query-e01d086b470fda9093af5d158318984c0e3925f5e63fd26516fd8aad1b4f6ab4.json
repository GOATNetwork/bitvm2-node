  "query": "SELECT message_id,\n                    business_id AS \"business_id:Uuid\",\n                    from_peer,\n                    actor,\n                    msg_type,\n                    content,\n                    state,\n                    weight,\n                    lock_time_until\n             FROM message\n             WHERE state = ?\n               AND weight >= ?\n               AND lock_time_until <= ?\n               AND updated_at >= ?\n             ORDER BY created_at ASC\n             LIMIT ? OFFSET ?",
